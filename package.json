{
  "name": "front-desk",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n client,api -c cyan,magenta \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:client": "npm run dev -w client",
    "dev:api": "npm run dev -w server",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
